#!/usr/bin/env python3
"""second-brain pre-commit — enforce CONVENTIONS §4 (docs ship with behavior).

Fails the commit if it changes behavior (engine, hooks, viz, or plugin config)
without also staging a docs change (any *.md — README / CONVENTIONS / INSTALL /
a SKILL.md / commands). Bypass a false positive with `git commit --no-verify`.

Enable once per clone:  git config core.hooksPath .githooks
"""

import subprocess
import sys

# staged, added/copied/modified/renamed (ignore deletions)
try:
    staged = subprocess.check_output(
        ["git", "diff", "--cached", "--name-only", "--diff-filter=ACMR"],
        text=True).split()
except Exception:
    sys.exit(0)  # nothing to check / not a git context


def is_behavior(f: str) -> bool:
    if f.startswith("scripts/") and f.endswith(".py"):
        return True
    if f.startswith("hooks/"):                 # Claude Code hooks (.py / .json / .sh)
        return True
    if f.startswith("viz/") and (f.endswith(".py") or f.endswith(".html")):
        return True
    if f.startswith(".claude-plugin/") and f.endswith(".json"):
        return True
    return False


def is_doc(f: str) -> bool:
    return f.endswith(".md")


behavior = [f for f in staged if is_behavior(f)]
docs = [f for f in staged if is_doc(f)]

if behavior and not docs:
    print("\n\033[31m✗ commit blocked — CONVENTIONS §4: docs must ship with behavior.\033[0m",
          file=sys.stderr)
    print("\nThese behavior files are staged with NO docs change:", file=sys.stderr)
    for f in behavior:
        print(f"  • {f}", file=sys.stderr)
    print("\nUpdate the docs that describe them (in this same commit):", file=sys.stderr)
    print("  CONVENTIONS.md · README.md · INSTALL.md · the relevant skills/*/SKILL.md"
          " · commands/ledger.md", file=sys.stderr)
    print("  then `grep` the docs for any stale mention of what you changed.", file=sys.stderr)
    print("\nIf this change genuinely needs no doc update, bypass with:", file=sys.stderr)
    print("  git commit --no-verify\n", file=sys.stderr)
    sys.exit(1)

sys.exit(0)
